<!DOCTYPE html>
<html lang="en" class="h-full bg-[#08080a] text-slate-100 dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Weekend Planner</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Bangers&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            comic: ['Bangers', 'cursive'],
          },
          colors: {
            brand: {
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              amber: '#f59e0b',
              emerald: '#10b981',
              rose: '#f43f5e',
              sky: '#0ea5e9',
              orange: '#f97316',
            },
            dark: {
              bg: '#08080a',
              surface: '#12141d',
              card: '#1a1d29',
              border: '#282c3f',
              hover: '#2d3247'
            }
          }
        }
      }
    };
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #08080a; }
    ::-webkit-scrollbar-thumb { background: #282c3f; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #6366f1; }

    body {
      background:
        radial-gradient(circle at 20% 20%, rgba(99, 102, 241, 0.15), transparent 25%),
        radial-gradient(circle at 80% 0%, rgba(245, 158, 11, 0.12), transparent 20%),
        #08080a;
    }

    .glass-panel {
      background: rgba(18, 20, 29, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .activity-card {
      background: rgba(26, 29, 41, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .activity-card:hover {
      background: rgba(26, 29, 41, 0.9);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .spinner {
      border: 3px solid rgba(99, 102, 241, 0.2);
      border-top: 3px solid #6366f1;
      border-radius: 50%;
      width: 42px;
      height: 42px;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .checkbox-custom {
      appearance: none;
      width: 18px;
      height: 18px;
      border: 2px solid #6366f1;
      border-radius: 6px;
      background: transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }

    .checkbox-custom:checked {
      background: #6366f1;
      box-shadow: inset 0 0 0 3px #08080a;
    }

    .checkbox-custom:hover {
      border-color: #818cf8;
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.25);
    }
  </style>
</head>
<body class="min-h-full flex flex-col font-sans overflow-hidden bg-dark-bg text-slate-100 antialiased">

  <header class="bg-dark-surface/90 backdrop-blur-xl border-b border-dark-border px-4 sm:px-6 py-4 shrink-0">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-brand-amber flex items-center justify-center font-comic text-2xl shadow-lg shadow-brand-600/30">🎯</div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-brand-400 bg-clip-text text-transparent">Weekend Planner</h1>
          <p class="text-[10px] sm:text-xs text-brand-amber font-semibold uppercase tracking-[0.2em]">Weather + Food + Outdoor Fun</p>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6">
    <div class="max-w-7xl mx-auto space-y-6">

      <section class="glass-panel rounded-2xl p-5 sm:p-6 space-y-4">
        <h2 class="text-lg font-bold text-white">Plan your upcoming weekend</h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Zip code</label>
            <input id="zip-code-input" type="text" placeholder="Enter zip code (e.g. 10001)" maxlength="10" class="w-full px-4 py-3 rounded-xl bg-dark-bg border border-dark-border text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">What are you in the mood for?</label>
            <div class="flex flex-wrap gap-2">
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="outdoor" checked>
                <span class="text-sm">🏞️ Outdoor</span>
              </label>
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="dining" checked>
                <span class="text-sm">🍽️ Dining</span>
              </label>
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="adventure">
                <span class="text-sm">🎢 Adventure</span>
              </label>
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="cultural">
                <span class="text-sm">🎭 Cultural</span>
              </label>
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="sports">
                <span class="text-sm">⚽ Sports</span>
              </label>
              <label class="flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-dark-hover transition cursor-pointer">
                <input type="checkbox" class="activity-checkbox checkbox-custom" value="shopping">
                <span class="text-sm">🛍️ Shopping</span>
              </label>
            </div>
          </div>
        </div>

        <button id="generate-btn" class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 text-white font-bold transition shadow-lg shadow-brand-600/25 active:scale-[0.99]">
          ✨ Generate weekend plan
        </button>
      </section>

      <section id="loading-state" class="hidden glass-panel rounded-2xl p-10 flex flex-col items-center justify-center space-y-4">
        <div class="spinner"></div>
        <p class="font-semibold text-slate-200">Checking the weather and building your plan...</p>
      </section>

      <section id="error-state" class="hidden glass-panel rounded-2xl p-5 border border-brand-rose/40 bg-brand-rose/5">
        <p id="error-message" class="text-brand-rose font-semibold"></p>
      </section>

      <section id="weather-section" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white">Weekend weather</h2>
          <span id="weekend-range" class="text-xs text-slate-400 font-medium"></span>
        </div>
        <div id="weather-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </section>

      <section id="activities-section" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white">Your personalized plan</h2>
          <button id="regenerate-btn" class="px-4 py-2 rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold transition">
            🔄 Regenerate
          </button>
        </div>
        <div id="activities-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
      </section>

    </div>
  </main>

  <script>
    const state = {
      zipCode: '',
      selectedActivities: ['outdoor', 'dining'],
      weekendDates: null,
      weatherData: null,
      coordinates: null,
      activities: []
    };

    const elements = {
      zipCodeInput: document.getElementById('zip-code-input'),
      generateBtn: document.getElementById('generate-btn'),
      regenerateBtn: document.getElementById('regenerate-btn'),
      loadingState: document.getElementById('loading-state'),
      errorState: document.getElementById('error-state'),
      errorMessage: document.getElementById('error-message'),
      weatherSection: document.getElementById('weather-section'),
      weatherCards: document.getElementById('weather-cards'),
      activitiesSection: document.getElementById('activities-section'),
      activitiesGrid: document.getElementById('activities-grid'),
      weekendRange: document.getElementById('weekend-range'),
      checkboxes: document.querySelectorAll('.activity-checkbox')
    };

    function getUpcomingWeekend() {
      const today = new Date();
      const currentDay = today.getDay();

      let friday = new Date(today);
      let saturday = new Date(today);
      let sunday = new Date(today);

      if (currentDay === 5) {
        friday = new Date(today);
        saturday = new Date(today.getTime() + 86400000);
        sunday = new Date(today.getTime() + 172800000);
      } else if (currentDay === 6) {
        friday = new Date(today.getTime() - 86400000);
        saturday = new Date(today);
        sunday = new Date(today.getTime() + 86400000);
      } else if (currentDay === 0) {
        friday = new Date(today.getTime() - 172800000);
        saturday = new Date(today.getTime() - 86400000);
        sunday = new Date(today);
      } else {
        const daysUntilFriday = (5 - currentDay + 7) % 7 || 7;
        friday = new Date(today.getTime() + daysUntilFriday * 86400000);
        saturday = new Date(today.getTime() + (daysUntilFriday + 1) * 86400000);
        sunday = new Date(today.getTime() + (daysUntilFriday + 2) * 86400000);
      }

      return {
        friday,
        saturday,
        sunday,
        rangeText: `${formatDateShort(friday)} - ${formatDateShort(sunday)}`
      };
    }

    function formatDateShort(date) {
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function updateSelectedActivities() {
      state.selectedActivities = Array.from(elements.checkboxes)
        .filter((cb) => cb.checked)
        .map((cb) => cb.value);
    }

    function showError(message) {
      elements.errorMessage.textContent = message;
      elements.errorState.classList.remove('hidden');
      elements.loadingState.classList.add('hidden');
      elements.weatherSection.classList.add('hidden');
      elements.activitiesSection.classList.add('hidden');
    }

    function hideError() {
      elements.errorState.classList.add('hidden');
    }

    function showLoading() {
      elements.loadingState.classList.remove('hidden');
      elements.weatherSection.classList.add('hidden');
      elements.activitiesSection.classList.add('hidden');
      hideError();
    }

    async function geocodeZipCode(zip) {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?postalcode=${zip}&country=US&format=json`);
      const data = await response.json();

      if (!data || data.length === 0) {
        throw new Error('Could not find that zip code. Please try another one.');
      }

      const result = data[0];
      return {
        lat: parseFloat(result.lat),
        lon: parseFloat(result.lon),
        city: result.address?.city || result.name || 'your area'
      };
    }

    async function fetchWeatherForWeekend(lat, lon) {
      const pointsResponse = await fetch(`https://api.weather.gov/points/${lat},${lon}`);
      if (!pointsResponse.ok) {
        throw new Error('Weather.gov could not find a forecast for that location.');
      }

      const points = await pointsResponse.json();
      const forecastResponse = await fetch(points.properties.forecast);
      const forecast = await forecastResponse.json();
      return forecast.properties.periods;
    }

    function filterWeekendWeather(periods) {
      const start = state.weekendDates.friday.getTime();
      const end = state.weekendDates.sunday.getTime() + 86400000;

      return periods.filter((period) => {
        const periodTime = new Date(period.startTime).getTime();
        return periodTime >= start && periodTime <= end;
      });
    }

    function getWeatherEmoji(summary) {
      const text = summary.toLowerCase();
      if (text.includes('sunny') || text.includes('clear')) return '☀️';
      if (text.includes('rain') || text.includes('showers') || text.includes('storm')) return '🌧️';
      if (text.includes('cloud')) return '☁️';
      if (text.includes('snow')) return '❄️';
      if (text.includes('fog') || text.includes('mist')) return '🌫️';
      if (text.includes('wind')) return '💨';
      return '🌤️';
    }

    function displayWeather(weekendWeather) {
      elements.weatherCards.innerHTML = '';
      const grouped = { Friday: [], Saturday: [], Sunday: [] };

      weekendWeather.forEach((period) => {
        const dayName = new Date(period.startTime).toLocaleDateString('en-US', { weekday: 'long' });
        if (grouped[dayName]) grouped[dayName].push(period);
      });

      Object.entries(grouped).forEach(([day, periods]) => {
        if (periods.length === 0) return;

        const temps = periods.map((p) => p.temperature).filter((v) => Number.isFinite(v));
        const avg = Math.round(temps.reduce((sum, value) => sum + value, 0) / temps.length);
        const summary = periods[0].shortForecast;
        const card = document.createElement('div');
        card.className = 'activity-card rounded-xl p-4 fade-in';
        card.innerHTML = `
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold text-white">${day}</h3>
            <span class="text-3xl">${getWeatherEmoji(summary)}</span>
          </div>
          <p class="text-sm text-slate-300">${summary}</p>
          <div class="mt-3 text-lg font-bold text-brand-400">${avg}°F</div>
        `;
        elements.weatherCards.appendChild(card);
      });
    }

    function generateActivities(weatherData, selectedActivities) {
      const avgTemp = weatherData.length
        ? Math.round(weatherData.reduce((sum, p) => sum + (p.temperature || 70), 0) / weatherData.length)
        : 70;

      const isRainy = weatherData.some((p) => (p.shortForecast || '').toLowerCase().includes('rain'));
      const isSunny = weatherData.some((p) => (p.shortForecast || '').toLowerCase().includes('sunny'));
      const isHot = avgTemp > 80;
      const isCold = avgTemp < 55;

      const activities = [];

      if (selectedActivities.includes('outdoor')) {
        if (isSunny && !isRainy) {
          activities.push({
            title: 'Sunlit Nature Walk',
            emoji: '🥾',
            description: 'Explore a nearby trail or scenic route and enjoy the fresh air.',
            time: 'Saturday 9:00 AM - 12:00 PM',
            reason: 'The weather is ideal for being outside',
            category: 'outdoor'
          });
        }

        if (isRainy) {
          activities.push({
            title: 'Covered Farmers Market',
            emoji: '🌽',
            description: 'Browse local produce, baked goods, and artisan finds without getting soaked.',
            time: 'Sunday 9:00 AM - 1:00 PM',
            reason: 'Rainy weather works well for a market stroll',
            category: 'outdoor'
          });
        }

        activities.push({
          title: 'Park Picnic & Chill Session',
          emoji: '🧺',
          description: 'Pack snacks, bring a blanket, and relax outdoors with a view.',
          time: 'Saturday or Sunday 12:00 PM',
          reason: 'Easy outdoor reset that fits your vibe',
          category: 'outdoor'
        });
      }

      if (selectedActivities.includes('dining')) {
        activities.push({
          title: 'Brunch Date Spot',
          emoji: '🥐',
          description: 'Discover a cozy brunch place with good coffee and a relaxed atmosphere.',
          time: 'Sunday 10:00 AM - 12:00 PM',
          reason: 'A perfect weekend food tradition',
          category: 'dining'
        });

        activities.push({
          title: 'Rooftop Dinner or Patio Night',
          emoji: '🍽️',
          description: 'Enjoy a casual or elevated meal outside when the weather is right.',
          time: 'Saturday 6:30 PM - 9:00 PM',
          reason: 'Good weather + great food = a win',
          category: 'dining'
        });

        activities.push({
          title: 'Neighborhood Food Crawl',
          emoji: '🍜',
          description: 'Try a few small bites from local spots close to home.',
          time: 'Friday Night or Sunday Afternoon',
          reason: 'Fun, flexible, and delicious',
          category: 'dining'
        });
      }

      if (selectedActivities.includes('adventure')) {
        if (!isRainy) {
          activities.push({
            title: 'Bike Ride Adventure',
            emoji: '🚴',
            description: 'Find a scenic loop or trail nearby and make it a low-key adventure.',
            time: 'Saturday 8:00 AM - 11:00 AM',
            reason: 'Comfortable weather makes this ideal',
            category: 'adventure'
          });
        }

        activities.push({
          title: 'Kayak or Water Activity',
          emoji: '🛶',
          description: 'If you have access to a lake or river nearby, this is a great active plan.',
          time: 'Sunday 2:00 PM - 5:00 PM',
          reason: 'A fun way to enjoy the weather outdoors',
          category: 'adventure'
        });
      }

      if (selectedActivities.includes('cultural')) {
        activities.push({
          title: 'Museum or Gallery Visit',
          emoji: '🏛️',
          description: 'Choose an art, history, or science museum for a relaxed indoor adventure.',
          time: 'Saturday 1:00 PM - 4:00 PM',
          reason: 'Great if you want something inspiring and low pressure',
          category: 'cultural'
        });

        activities.push({
          title: 'Live Music or Theatre Night',
          emoji: '🎭',
          description: 'Check local listings for a fun live show near you.',
          time: 'Friday or Saturday Night',
          reason: 'Perfect for a memorable evening',
          category: 'cultural'
        });
      }

      if (selectedActivities.includes('sports')) {
        activities.push({
          title: 'Local Game or Pick-up Match',
          emoji: '⚽',
          description: 'Catch a game, or join a casual sports meetup near you.',
          time: 'Saturday or Sunday Afternoon',
          reason: 'A fun way to stay active and social',
          category: 'sports'
        });
      }

      if (selectedActivities.includes('shopping')) {
        activities.push({
          title: 'Boutique Browse Session',
          emoji: '🛍️',
          description: 'Explore nearby shops, markets, and local boutiques.',
          time: 'Saturday 11:00 AM - 2:00 PM',
          reason: 'Nice way to enjoy a slow afternoon',
          category: 'shopping'
        });
      }

      return activities.slice(0, 9);
    }

    function displayActivities(items) {
      elements.activitiesGrid.innerHTML = '';

      items.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'activity-card rounded-xl p-5 fade-in';
        card.style.animationDelay = `${index * 50}ms`;

        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div class="text-4xl">${item.emoji}</div>
            <span class="text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-lg bg-brand-600/20 text-brand-300 border border-brand-500/20">${item.category}</span>
          </div>
          <div class="mt-4 space-y-2">
            <h3 class="text-lg font-bold text-white">${item.title}</h3>
            <p class="text-sm text-slate-300">${item.description}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-dark-border space-y-1 text-xs text-slate-400">
            <p>⏰ ${item.time}</p>
            <p>✨ ${item.reason}</p>
          </div>
        `;

        elements.activitiesGrid.appendChild(card);
      });
    }

    async function generateWeekendPlan() {
      state.zipCode = elements.zipCodeInput.value.trim();

      if (!state.zipCode) {
        showError('Please enter a ZIP code.');
        return;
      }

      updateSelectedActivities();

      if (state.selectedActivities.length === 0) {
        showError('Please pick at least one activity type.');
        return;
      }

      showLoading();

      try {
        state.weekendDates = getUpcomingWeekend();
        elements.weekendRange.textContent = state.weekendDates.rangeText;

        const coordinates = await geocodeZipCode(state.zipCode);
        state.coordinates = coordinates;

        const periods = await fetchWeatherForWeekend(coordinates.lat, coordinates.lon);
        const weekendWeather = filterWeekendWeather(periods);

        if (!weekendWeather.length) {
          throw new Error('Weather data was unavailable for the upcoming weekend.');
        }

        state.weatherData = weekendWeather;
        state.activities = generateActivities(weekendWeather, state.selectedActivities);

        displayWeather(weekendWeather);
        displayActivities(state.activities);

        elements.loadingState.classList.add('hidden');
        elements.weatherSection.classList.remove('hidden');
        elements.activitiesSection.classList.remove('hidden');
        hideError();
      } catch (err) {
        console.error(err);
        showError(err.message || 'Something went wrong while planning your weekend.');
      }
    }

    function regeneratePlan() {
      if (!state.weatherData || !state.selectedActivities.length) return;
      state.activities = generateActivities(state.weatherData, state.selectedActivities);
      displayActivities(state.activities);
    }

    elements.generateBtn.addEventListener('click', generateWeekendPlan);
    elements.regenerateBtn.addEventListener('click', regeneratePlan);
    elements.zipCodeInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') generateWeekendPlan();
    });
    elements.checkboxes.forEach((box) => {
      box.addEventListener('change', updateSelectedActivities);
    });

    state.weekendDates = getUpcomingWeekend();
    elements.weekendRange.textContent = state.weekendDates.rangeText;
  </script>
</body>
</html>
